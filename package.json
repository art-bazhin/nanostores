{
  "name": "nanostores",
  "version": "1.5.4",
  "description": "A tiny (898 bytes) state manager for React/Preact/Vue/Svelte with many atomic tree-shakable stores",
  "keywords": [
    "preact",
    "react",
    "react native",
    "state",
    "state manager",
    "store",
    "svelte",
    "vue"
  ],
  "license": "MIT",
  "author": "Andrey Sitnik <andrey@sitnik.es>",
  "repository": "nanostores/nanostores",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ai"
    }
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:build": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:test": "node --import tsx --test --watch \"src/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "test:lint": "oxlint",
    "test:unit": "pnpm bnt \"src/**/*.test.ts\"",
    "test:legacy": "node test/legacy/index.mjs",
    "test:types": "check-dts",
    "test:size": "pnpm build && size-limit",
    "test:synced": "node test/size-synced.ts",
    "test": "pnpm build && pnpm test:unit && pnpm test:legacy && pnpm test:lint"
  },
  "devDependencies": {
    "@logux/oxc-configs": "^1.2.0",
    "@sinonjs/fake-timers": "^15.4.0",
    "@size-limit/preset-small-lib": "^14.0.1",
    "@types/node": "^26.6.2",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "@types/ws": "^8.18.1",
    "benchmark": "^2.1.4",
    "better-node-test": "^0.8.4",
    "check-dts": "^2.0.1",
    "eslint-plugin-prefer-let": "^4.2.2",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "size-limit": "^14.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "size-limit": [
    {
      "name": "Atom",
      "import": {
        "./dist/index.js": "{ atom }"
      },
      "limit": "898 B"
    },
    {
      "name": "Atom + Computed",
      "import": {
        "./dist/index.js": "{ atom, computed }"
      },
      "limit": "1440 B"
    }
  ],
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "packageManager": "pnpm@11.13.0",
  "clean-publish": {
    "cleanDocs": true
  }
}
